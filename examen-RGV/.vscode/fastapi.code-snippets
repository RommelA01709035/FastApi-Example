{
  // Snippets para la arquitectura: middleware -> router -> controller -> usecase -> model
  // Placeholders comunes:
  //   $1 = Clase (PascalCase)          ej. Expense
  //   $2 = singular (snake_case)       ej. expense
  //   $3 = plural / carpeta / tabla    ej. expenses
  //   $4 = campo de texto principal    ej. description

  "FastAPI: model (app/domain/<plural>/models.py)": {
    "scope": "python",
    "prefix": "fa-model",
    "body": [
      "from datetime import datetime, timezone",
      "from decimal import Decimal",
      "from enum import Enum",
      "",
      "from sqlalchemy import DateTime, Numeric, String",
      "from sqlalchemy import Enum as SqlEnum",
      "from sqlalchemy.orm import Mapped, mapped_column",
      "",
      "from app.domain.errors import BusinessRuleError",
      "from app.infrastructure.database import Base",
      "",
      "",
      "class ${1:Expense}Status(str, Enum):",
      "    PENDING = \"PENDING\"",
      "    APPROVED = \"APPROVED\"",
      "    CANCELLED = \"CANCELLED\"",
      "",
      "",
      "class ${1}(Base):",
      "    __tablename__ = \"${3:expenses}\"",
      "",
      "    id: Mapped[int] = mapped_column(primary_key=True)",
      "    ${4:description}: Mapped[str] = mapped_column(String(255))",
      "    amount: Mapped[Decimal] = mapped_column(Numeric(14, 2))",
      "    status: Mapped[${1}Status] = mapped_column(",
      "        SqlEnum(${1}Status), default=${1}Status.PENDING",
      "    )",
      "    created_at: Mapped[datetime] = mapped_column(",
      "        DateTime(timezone=True), default=lambda: datetime.now(timezone.utc)",
      "    )",
      "",
      "    # Las reglas de negocio viven en el modelo.",
      "    def approve(self) -> None:",
      "        if self.status != ${1}Status.PENDING:",
      "            raise BusinessRuleError(",
      "                f\"Solo se aprueban registros pendientes (estado actual: {self.status.value})\"",
      "            )",
      "        self.status = ${1}Status.APPROVED",
      "$0"
    ],
    "description": "Modelo SQLAlchemy con enum de estado y una regla de negocio"
  },

  "FastAPI: usecases (app/domain/<plural>/usecases.py)": {
    "scope": "python",
    "prefix": "fa-usecases",
    "body": [
      "from sqlalchemy import func, select",
      "from sqlalchemy.orm import Session",
      "",
      "from app.domain.errors import NotFoundError",
      "from app.domain.${3:expenses}.models import ${1:Expense}",
      "",
      "",
      "def list_${3}(db: Session, limit: int, offset: int) -> tuple[list[${1}], int]:",
      "    \"\"\"Devuelve una página de registros y el total.\"\"\"",
      "    total = db.scalar(select(func.count()).select_from(${1}))",
      "    query = select(${1}).order_by(${1}.id.desc()).limit(limit).offset(offset)",
      "    return list(db.scalars(query)), total",
      "",
      "",
      "def get_${2:expense}(db: Session, ${2}_id: int) -> ${1}:",
      "    ${2} = db.get(${1}, ${2}_id)",
      "    if not ${2}:",
      "        raise NotFoundError(f\"${1} {${2}_id} no encontrado\")",
      "    return ${2}",
      "",
      "",
      "def create_${2}(db: Session, **data) -> ${1}:",
      "    ${2} = ${1}(**data)",
      "    db.add(${2})",
      "    db.flush()",
      "    return ${2}",
      "",
      "",
      "def approve_${2}(db: Session, ${2}_id: int) -> ${1}:",
      "    ${2} = get_${2}(db, ${2}_id)",
      "    ${2}.approve()  # la regla la valida el modelo",
      "    db.flush()",
      "    return ${2}",
      "$0"
    ],
    "description": "Casos de uso: listar, obtener, crear y una acción"
  },

  "FastAPI: schemas (app/presentation/schemas/<plural>.py)": {
    "scope": "python",
    "prefix": "fa-schemas",
    "body": [
      "from datetime import datetime",
      "from decimal import Decimal",
      "",
      "from pydantic import BaseModel, ConfigDict, Field",
      "",
      "from app.domain.${3:expenses}.models import ${1:Expense}Status",
      "",
      "",
      "class ${1}Create(BaseModel):",
      "    ${4:description}: str = Field(min_length=1, max_length=255)",
      "    amount: Decimal = Field(gt=0, max_digits=14, decimal_places=2)",
      "",
      "",
      "class ${1}Out(BaseModel):",
      "    model_config = ConfigDict(from_attributes=True)",
      "",
      "    id: int",
      "    ${4}: str",
      "    amount: Decimal",
      "    status: ${1}Status",
      "    created_at: datetime",
      "",
      "",
      "class ${1}List(BaseModel):",
      "    ${3}: list[${1}Out]",
      "    total: int",
      "    limit: int",
      "    offset: int",
      "$0"
    ],
    "description": "Schemas Pydantic: Create, Out y List paginada"
  },

  "FastAPI: controller (app/presentation/controllers/<plural>.py)": {
    "scope": "python",
    "prefix": "fa-controller",
    "body": [
      "from pathlib import Path",
      "",
      "from fastapi import Request",
      "from fastapi.templating import Jinja2Templates",
      "from sqlalchemy.orm import Session",
      "",
      "from app.domain.${3:expenses} import usecases",
      "from app.presentation.schemas.${3} import ${1:Expense}Create, ${1}List, ${1}Out",
      "",
      "templates = Jinja2Templates(directory=Path(__file__).parent.parent / \"templates\")",
      "",
      "",
      "# ---------- API (JSON) ----------",
      "",
      "def list_${3}(db: Session, limit: int, offset: int) -> ${1}List:",
      "    items, total = usecases.list_${3}(db, limit, offset)",
      "    return ${1}List(",
      "        ${3}=[${1}Out.model_validate(item) for item in items],",
      "        total=total,",
      "        limit=limit,",
      "        offset=offset,",
      "    )",
      "",
      "",
      "def get_${2:expense}(db: Session, ${2}_id: int) -> ${1}Out:",
      "    return ${1}Out.model_validate(usecases.get_${2}(db, ${2}_id))",
      "",
      "",
      "def create_${2}(db: Session, body: ${1}Create) -> ${1}Out:",
      "    return ${1}Out.model_validate(usecases.create_${2}(db, **body.model_dump()))",
      "",
      "",
      "def approve_${2}(db: Session, ${2}_id: int) -> ${1}Out:",
      "    return ${1}Out.model_validate(usecases.approve_${2}(db, ${2}_id))",
      "",
      "",
      "# ---------- Frontend (HTML) ----------",
      "",
      "def ${3}_page(request: Request, db: Session, limit: int, offset: int):",
      "    page = list_${3}(db, limit, offset)",
      "    return templates.TemplateResponse(request, \"${3}/list.html\", {\"page\": page})",
      "$0"
    ],
    "description": "Controller: arma schemas JSON y renderiza HTML"
  },

  "FastAPI: router (app/presentation/routers/<plural>.py)": {
    "scope": "python",
    "prefix": "fa-router",
    "body": [
      "from fastapi import APIRouter, Depends, Query, Request, status",
      "from fastapi.responses import HTMLResponse",
      "from sqlalchemy.orm import Session",
      "",
      "from app.infrastructure.database import get_db",
      "from app.presentation.controllers import ${3:expenses} as controller",
      "from app.presentation.schemas.${3} import ${1:Expense}Create, ${1}List, ${1}Out",
      "",
      "router = APIRouter(tags=[\"${3}\"])",
      "",
      "",
      "# ---------- API REST (JSON) ----------",
      "",
      "@router.get(\"/api/${3}\", response_model=${1}List)",
      "def list_${3}(",
      "    limit: int = Query(10, ge=1, le=100),",
      "    offset: int = Query(0, ge=0),",
      "    db: Session = Depends(get_db),",
      "):",
      "    return controller.list_${3}(db, limit, offset)",
      "",
      "",
      "@router.get(\"/api/${3}/{${2:expense}_id}\", response_model=${1}Out)",
      "def get_${2}(${2}_id: int, db: Session = Depends(get_db)):",
      "    return controller.get_${2}(db, ${2}_id)",
      "",
      "",
      "@router.post(\"/api/${3}\", response_model=${1}Out, status_code=status.HTTP_201_CREATED)",
      "def create_${2}(body: ${1}Create, db: Session = Depends(get_db)):",
      "    return controller.create_${2}(db, body)",
      "",
      "",
      "@router.post(\"/api/${3}/{${2}_id}/approve\", response_model=${1}Out)",
      "def approve_${2}(${2}_id: int, db: Session = Depends(get_db)):",
      "    return controller.approve_${2}(db, ${2}_id)",
      "",
      "",
      "# ---------- Frontend (HTML + Bulma) ----------",
      "",
      "@router.get(\"/${3}\", response_class=HTMLResponse, include_in_schema=False)",
      "def ${3}_page(",
      "    request: Request,",
      "    limit: int = Query(10, ge=1, le=100),",
      "    offset: int = Query(0, ge=0),",
      "    db: Session = Depends(get_db),",
      "):",
      "    return controller.${3}_page(request, db, limit, offset)",
      "$0"
    ],
    "description": "Router: endpoints JSON + página HTML"
  },

  "FastAPI: registrar router en main.py": {
    "scope": "python",
    "prefix": "fa-include",
    "body": [
      "from app.presentation.routers import ${1:expenses}",
      "app.include_router(${1}.router)$0"
    ],
    "description": "Import + include_router (mueve el import arriba si quieres)"
  },

  "FastAPI: página Bulma (app/presentation/templates/<plural>/list.html)": {
    "scope": "html,jinja-html,jinja",
    "prefix": "fa-page",
    "body": [
      "{% extends \"base.html\" %}",
      "",
      "{% block title %}${1:Gastos}{% endblock %}",
      "",
      "{% block content %}",
      "<h1 class=\"title\">${1}</h1>",
      "<p class=\"subtitle is-6\">{{ page.total }} registros</p>",
      "",
      "<table class=\"table is-fullwidth is-striped is-hoverable\">",
      "  <thead>",
      "    <tr>",
      "      <th>#</th>",
      "      <th>${2:Descripción}</th>",
      "      <th class=\"has-text-right\">Monto</th>",
      "      <th>Estado</th>",
      "      <th>Fecha</th>",
      "    </tr>",
      "  </thead>",
      "  <tbody>",
      "    {% for item in page.${3:expenses} %}",
      "      <tr>",
      "        <td>{{ item.id }}</td>",
      "        <td>{{ item.${4:description} }}</td>",
      "        <td class=\"has-text-right\">\\${{ \"{:,.2f}\".format(item.amount) }}</td>",
      "        <td><span class=\"tag\">{{ item.status.value }}</span></td>",
      "        <td>{{ item.created_at.strftime(\"%d/%m/%Y %H:%M\") }}</td>",
      "      </tr>",
      "    {% else %}",
      "      <tr><td colspan=\"5\" class=\"has-text-centered has-text-grey\">Sin registros</td></tr>",
      "    {% endfor %}",
      "  </tbody>",
      "</table>",
      "",
      "{% set prev_offset = page.offset - page.limit %}",
      "{% set next_offset = page.offset + page.limit %}",
      "<nav class=\"pagination is-right\">",
      "  <a class=\"pagination-previous\" href=\"?limit={{ page.limit }}&offset={{ prev_offset }}\"",
      "     {% if page.offset <= 0 %}disabled style=\"pointer-events: none\"{% endif %}>Anterior</a>",
      "  <a class=\"pagination-next\" href=\"?limit={{ page.limit }}&offset={{ next_offset }}\"",
      "     {% if next_offset >= page.total %}disabled style=\"pointer-events: none\"{% endif %}>Siguiente</a>",
      "</nav>",
      "{% endblock %}",
      "$0"
    ],
    "description": "Tabla Bulma paginada que consume el controller"
  }
}
